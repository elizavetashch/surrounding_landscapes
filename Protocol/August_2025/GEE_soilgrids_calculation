// -------------------------
// USER: change these values
// -------------------------
var points = ee.FeatureCollection("projects/ee-elizaveta/assets/20241010_data_yield");
var bufferRadius = 1000; // meters
var useSquareBounds = false; // true => square, false => round
var scale = 30; // reducer scale (m)

// -------------------------
// IMAGES / LAYERS
// -------------------------
var sand   = ee.Image("projects/soilgrids-isric/sand_mean");
var bdod   = ee.Image("projects/soilgrids-isric/bdod_mean");
var cec    = ee.Image("projects/soilgrids-isric/cec_mean");
var clay   = ee.Image("projects/soilgrids-isric/clay_mean");
var nitrogen = ee.Image("projects/soilgrids-isric/nitrogen_mean");
var ocd    = ee.Image("projects/soilgrids-isric/ocd_mean");
var ocs    = ee.Image("projects/soilgrids-isric/ocs_mean");
var phh2o  = ee.Image("projects/soilgrids-isric/phh2o_mean");
var silt   = ee.Image("projects/soilgrids-isric/silt_mean");
var soc    = ee.Image("projects/soilgrids-isric/soc_mean");

var images = [sand, bdod, cec, clay, nitrogen, ocd, ocs, phh2o, silt, soc];

// -------------------------
// Buffer points
// -------------------------
function bufferPoints(radius, bounds) {
  return function(pt) {
    var geom = bounds ? pt.geometry().buffer(radius).bounds()
                      : pt.geometry().buffer(radius);
    return pt.setGeometry(geom);
  };
}

var bufferedPoints = points.map(bufferPoints(bufferRadius, useSquareBounds));

// -------------------------
// Calculate means
// -------------------------
var pointsWithMeans = bufferedPoints.map(function(pt) {
  var geom = pt.geometry();

  var updated = ee.List(images).iterate(function(img, accFeature) {
    accFeature = ee.Feature(accFeature);
    var image = ee.Image(img);

    // select 3rd band if exists, else first
    var bnames = image.bandNames();
    var bandName = ee.String(
      ee.Algorithms.If(bnames.size().gt(2), bnames.get(2), bnames.get(0))
    );

    // reduce to mean inside buffer
    var meanDict = image.select([bandName]).reduceRegion({
      reducer: ee.Reducer.mean(),
      geometry: geom,
      scale: scale,
      maxPixels: 1e13
    });

    var meanVal = meanDict.get(bandName);

    // keep your original labeling approach (system:id + _mean)
    var propName = ee.String(image.get('system:id')).cat('_mean');

    return accFeature.set(propName, meanVal);
  }, pt);

  return ee.Feature(updated);
});

// -------------------------
// Output & export
// -------------------------
print('Sample with mean properties:', pointsWithMeans.limit(5));

Export.table.toDrive({
  collection: pointsWithMeans,
  description: '20250810_points_means_export',
  folder: "GEE_SoilGrids",
  fileFormat: 'CSV'
});
