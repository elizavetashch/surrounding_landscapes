// -------------------------
// Analysis Code 
// -------------------------

// (1) Function to buffer the points 
function bufferPoints(radius, bounds) {
  return function(pt) {
    var geom = bounds ? pt.geometry().buffer(radius).bounds()
                      : pt.geometry().buffer(radius);
    return pt.setGeometry(geom);
  };
}


// (2) Add pixel value at point location
function addPixelValue(points, image, scale) {
  return points.map(function(point) {
    var value = image.reduceRegion({
      reducer: ee.Reducer.first(),
      geometry: point.geometry(),
      scale: scale,
      maxPixels: 1e13
    });
    
    // Get band name (assuming one band image)
    var bandName = image.bandNames().get(0);
    var pixelValue = ee.Number(value.get(bandName));
    
    return point.set('pixelvalue', pixelValue);
  });
}

// (3) Process buffered points to get area per class
function processMetrics(points, image, bufferRadius, scale) {
  var bufferedPoints = points.map(bufferPoints(bufferRadius, false));

  var results = bufferedPoints.map(function(point) {
    var bufferGeom = point.geometry();
    var areaImage = ee.Image.pixelArea().addBands(image.rename('class'));
    var areasum = areaImage.reduceRegion({
      reducer: ee.Reducer.sum().group({
        groupField: 1,     
        groupName: 'class'
      }),
      geometry: bufferGeom,
      scale: scale,
      maxPixels: 1e13
    });
    var groups = ee.List(areasum.get('groups'));
    // Return results as a feature
    return ee.Feature(point).set({
      metrics: groups
    });
  });

  return results;
}



// (4) Unpack the metrics (area and class) list into a feature collection
// you have to unpack your metrics, because otherwise you will have dictionaries of classes in your csv file.
function unpackMetrics(feature) {
  var metrics = ee.List(feature.get('metrics'));
  var newFeatures = metrics.map(function(metric) {
    metric = ee.Dictionary(metric);
    return feature.copyProperties(feature).set({ 
      'class': metric.get('class'),
      'area_m2': metric.get('sum')
    });
  });
  return ee.FeatureCollection(newFeatures);
}


