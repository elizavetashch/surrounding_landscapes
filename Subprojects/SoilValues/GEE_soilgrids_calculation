// -------------------------
// Read in the data
// -------------------------
var points = ee.FeatureCollection("projects/ee-elizaveta/assets/20250812_points_onlyID");
var bufferRadius = 2500; // meters
var scale = 250; // reducer scale (m)

// -------------------------
// SoilGrids images
// -------------------------
var imageList = [
  {name: 'sand',     image: ee.Image("projects/soilgrids-isric/sand_mean")},
  {name: 'bdod',     image: ee.Image("projects/soilgrids-isric/bdod_mean")},
  {name: 'cec',      image: ee.Image("projects/soilgrids-isric/cec_mean")},
  {name: 'clay',     image: ee.Image("projects/soilgrids-isric/clay_mean")},
  {name: 'nitrogen', image: ee.Image("projects/soilgrids-isric/nitrogen_mean")},
  {name: 'ocd',      image: ee.Image("projects/soilgrids-isric/ocd_mean")},
  {name: 'ocs',      image: ee.Image("projects/soilgrids-isric/ocs_mean")},
  {name: 'phh2o',    image: ee.Image("projects/soilgrids-isric/phh2o_mean")},
  {name: 'silt',     image: ee.Image("projects/soilgrids-isric/silt_mean")},
  {name: 'soc',      image: ee.Image("projects/soilgrids-isric/soc_mean")}
];

// Validation: Band name check 
imageList.forEach(function(obj) {
  obj = ee.Dictionary(obj);
  var name = obj.get('name');
  var img = ee.Image(obj.get('image'));
  print(name, img.bandNames());
});


// -------------------------
// Buffer points
// -------------------------

function bufferPoints(radius, bounds) {
  return function(pt) {
    var geom = bounds ? pt.geometry().buffer(radius).bounds()
                      : pt.geometry().buffer(radius);
    return pt.setGeometry(geom);
  };
}

var bufferedPoints = points.map(bufferPoints(bufferRadius, false));

// -------------------------
// Calculate means
// -------------------------
var soilvalues = bufferedPoints.map(function(pt) {
  var geom = pt.geometry();

  var updated = ee.List(imageList).iterate(function(obj, accFeature) {
    accFeature = ee.Feature(accFeature);
    obj = ee.Dictionary(obj);
    var baseName = ee.String(obj.get('name'));
    var image = ee.Image(obj.get('image'));

    // Get band names
    var bandNames = image.bandNames();

    // Iterate over each band in this image
    var featureWithBands = ee.List(bandNames).iterate(function(band, innerFeature) {
      innerFeature = ee.Feature(innerFeature);

      // Reduce region for this band
      var meanDict = image.select([ee.String(band)]).reduceRegion({
        reducer: ee.Reducer.mean(),
        geometry: geom,
        scale: scale,
        maxPixels: 1e13
      });

      var meanVal = meanDict.get(band);

      // Column name: <imageName>_<bandName>_mean
      var propName = baseName.cat('_').cat(ee.String(band)).cat('_mean');

      return innerFeature.set(propName, meanVal);
    }, accFeature);

    return ee.Feature(featureWithBands);
  }, pt);

  return ee.Feature(updated);
});

// -------------------------
// Output & export
// -------------------------

Export.table.toDrive({
  collection: soilvalues,
  description: '20250812_soilvalues_2500m',
  folder: "GEE_SoilGrids",
  fileFormat: 'CSV'
});


